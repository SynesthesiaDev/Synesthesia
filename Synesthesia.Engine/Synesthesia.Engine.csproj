<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Synesthesia.Engine</PackageId>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="0.8.2-beta.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.Structs" Version="0.6.1-beta.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Faster.Map" Version="8.1.1"/>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4"/>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetFabric.Hyperlinq" Version="3.0.0-beta48"/>
    <PackageReference Include="NetFabric.Hyperlinq.Analyzer" Version="2.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTabletDriver" Version="0.6.6.2"/>
    <PackageReference Include="Pastel" Version="7.0.1"/>
    <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035"/>
    <PackageReference Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353"/>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0"/>
    <PackageReference Include="SynesthesiaUtils" Version="1.2.0"/>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Shaders/**/*.vert" />
    <AdditionalFiles Include="Shaders/**/*.frag" />
    <AdditionalFiles Include="Shaders/**/*.vs" />
    <AdditionalFiles Include="Shaders/**/*.fs" />
  </ItemGroup>

  <PropertyGroup>
    <GeneratorControl>EnableIncrementalControl</GeneratorControl>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Synesthesia.SourceGenerators\Synesthesia.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
